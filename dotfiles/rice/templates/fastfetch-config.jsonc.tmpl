// ~/.config/fastfetch/config.jsonc
// Minimal translucent system summary for the sidebar logo popup.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // The संगणक chip mark (~/.config/fastfetch/sanganak-logo.txt): $1 pins,
    // outline + ridge (c2), $2 sun (accent), $3 ground line (c3). Truecolor SGR
    // (38;2;R;G;B) so the hex is exact on every fastfetch version.
    "logo": {
        "type": "file",
        "source": "@HOME@/.config/fastfetch/sanganak-logo.txt",
        "padding": { "top": 1, "right": 3 },
        "color": { "1": "@BLUE_SGR@", "2": "@ACCENT_SGR@", "3": "@CYAN_SGR@" }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "@CYAN_SGR@", "title": "@ACCENT_SGR@" }  // c3 keys, accent title
    },
    "modules": [
        "title",
        "separator",
        { "type": "os",          "key": " os    " },
        { "type": "kernel",      "key": " kernel" },
        { "type": "uptime",      "key": " uptime" },
        { "type": "packages",    "key": "󰏖 pkgs  " },
        { "type": "wm",          "key": " wm    " },
        { "type": "terminal",    "key": " term  " },
        { "type": "cpu",         "key": " cpu   " },
        { "type": "gpu",         "key": "󰢮 gpu   " },
        { "type": "memory",      "key": " mem   " },
        { "type": "display",     "key": "󰍹 disp  " },
        "break",
        "colors"
    ]
}
