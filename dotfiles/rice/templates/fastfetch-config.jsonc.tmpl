// ~/.config/fastfetch/config.jsonc
// Minimal translucent system summary for the sidebar logo popup.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // The संगणक chip mark as 24-bit half-block pixel art — the same square chip
    // as the login screen. `rice-theme` renders it in the active palette with
    // `sanganak-logo ansi` (32 px → 32 columns × 16 rows); file-raw prints the
    // escape codes as-is, so width/height must match that size.
    "logo": {
        "type": "file-raw",
        "source": "@HOME@/.config/fastfetch/sanganak-logo.ansi",
        "width": 32,
        "height": 16,
        "padding": { "top": 0, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "@CYAN_SGR@", "title": "@ACCENT_SGR@" }  // c3 keys, accent title
    },
    "modules": [
        "title",
        "separator",
        { "type": "os",          "key": " os    " },
        { "type": "kernel",      "key": " kernel" },
        { "type": "uptime",      "key": " uptime" },
        { "type": "packages",    "key": "󰏖 pkgs  " },
        { "type": "wm",          "key": " wm    " },
        { "type": "terminal",    "key": " term  " },
        { "type": "cpu",         "key": " cpu   " },
        { "type": "gpu",         "key": "󰢮 gpu   " },
        { "type": "memory",      "key": " mem   " },
        { "type": "display",     "key": "󰍹 disp  " },
        "break",
        "colors"
    ]
}
