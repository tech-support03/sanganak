// ~/.config/fastfetch/config.jsonc
// Minimal translucent system summary for the bar's Arch-logo popup.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // The stock Arch Linux logo (fastfetch builtin), both colour slots in the
    // theme accent so it re-themes with `rice-theme` like everything else.
    "logo": {
        "type": "builtin",
        "source": "arch",
        "color": { "1": "@ACCENT_SGR@", "2": "@ACCENT_SGR@" },
        "padding": { "top": 0, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "@CYAN_SGR@", "title": "@ACCENT_SGR@" }  // c3 keys, accent title
    },
    "modules": [
        "title",
        "separator",
        { "type": "os",          "key": " os    " },
        { "type": "kernel",      "key": " kernel" },
        { "type": "uptime",      "key": " uptime" },
        { "type": "packages",    "key": "󰏖 pkgs  " },
        { "type": "wm",          "key": " wm    " },
        { "type": "terminal",    "key": " term  " },
        { "type": "cpu",         "key": " cpu   " },
        { "type": "gpu",         "key": "󰢮 gpu   " },
        { "type": "memory",      "key": " mem   " },
        { "type": "display",     "key": "󰍹 disp  " },
        "break",
        "colors"
    ]
}
